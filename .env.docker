# ═══════════════════════════════════════════════════
# Database Configuration - 数据库配置
# ═══════════════════════════════════════════════════
# Option 1: 使用Supabase (当前配置)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-eu-west-1.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.jxqrdqnfwqukunugydxd
SPRING_DATASOURCE_PASSWORD=0dJRqBsPH3ixXKkw

# Option 2: 使用本地PostgreSQL (取消注释以使用)
# POSTGRES_DB=fyp_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_PORT=5432
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/fyp_db
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres

# ═══════════════════════════════════════════════════
# JWT Configuration - JWT配置
# ═══════════════════════════════════════════════════
JWT_SECRET=change-this-secret-to-a-long-random-string-at-least-32-bytes

# ═══════════════════════════════════════════════════
# Supabase Storage - Supabase存储配置
# ═══════════════════════════════════════════════════
SUPABASE_URL=https://jxqrdqnfwqukunugydxd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imp4cXJkcW5md3F1a3VudWd5ZHhkIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2NTkxMTcwOCwiZXhwIjoyMDgxNDg3NzA4fQ.YYPjmH-n8asqtRN2CN11F48lTsdEDjZMevTSM9CTAj4
SUPABASE_BUCKET_NAME=campaign-images
SUPABASE_STORAGE_ENABLED=true

# ═══════════════════════════════════════════════════
# Fabric Configuration - Fabric区块链配置
# ═══════════════════════════════════════════════════
FABRIC_ENABLED=true
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=donation
FABRIC_MSP_ID=Org1MSP

# Docker模式：使用Fabric网络容器名称
FABRIC_PEER_ENDPOINT=peer0.org1.example.com:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com

# Docker模式：使用容器内挂载的路径
FABRIC_CERT_PATH=/fabric/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/signcerts/cert.pem
FABRIC_KEY_PATH=/fabric/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/keystore
FABRIC_TLS_CERT_PATH=/fabric/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
