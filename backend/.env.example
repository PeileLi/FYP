# Supabase Database Configuration (Connection Pooler)
# Using Supabase Connection Pooler for better performance and connection management

# Supabase Database URL (JDBC format)
# Host: aws-1-eu-west-1.pooler.supabase.com
# Port: 5432
# Database: postgres
# User: postgres.jxqrdqnfwqukunugydxd
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Supabase Database Username (with project reference)
SPRING_DATASOURCE_USERNAME=postgres.jxqrdqnfwqukunugydxd

# Supabase Database Password
# Find this in: Project Settings > Database > Database password
SPRING_DATASOURCE_PASSWORD=[YOUR-PASSWORD]

# JWT Secret (change this to a secure random string in production)
JWT_SECRET=your-secure-jwt-secret-key-here-change-this-in-production

# Connection pooling settings for Supabase Pooler
# Note: Supabase Pooler already manages connections, so we keep the pool size moderate
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
# SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2
