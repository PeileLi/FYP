# ===================================
# Supabase Database Configuration
# ===================================
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-eu-west-1.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.jxqrdqnfwqukunugydxd
SPRING_DATASOURCE_PASSWORD=[YOUR-DATABASE-PASSWORD]

# ===================================
# Supabase Storage Configuration
# ===================================
# Your Supabase Project URL (find in: Project Settings > API)
# Format: https://<project-ref>.supabase.co
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Service Role Key (find in: Project Settings > API > service_role key)
# WARNING: Keep this secret! Never commit to git!
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Storage Bucket Name (the bucket you created)
SUPABASE_BUCKET_NAME=campaign-images

# Enable/Disable Supabase Storage
SUPABASE_STORAGE_ENABLED=true

# ===================================
# JWT Configuration
# ===================================
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-bytes

