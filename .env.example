# ═══════════════════════════════════════════════════════════════
# FYP Donation Platform - Environment Configuration Template
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# This file is used by:
#   - docker-compose (automatically reads .env)
#   - Spring Boot local dev (backend/.env symlinks to this file)
# ═══════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════
# Database Configuration - 数据库配置
# ═══════════════════════════════════════════════════════════════
# Option A: Supabase (cloud hosted)
# SPRING_DATASOURCE_URL=jdbc:postgresql://<your-supabase-host>:5432/postgres
# SPRING_DATASOURCE_USERNAME=postgres.<your-project-ref>
# SPRING_DATASOURCE_PASSWORD=<your-supabase-password>

# Option B: Local PostgreSQL (docker-compose 中的 postgres 容器)
POSTGRES_DB=fyp_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/fyp_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres


# ═══════════════════════════════════════════════════════════════
# JWT Configuration - JWT 认证配置
# ═══════════════════════════════════════════════════════════════
# IMPORTANT: Change this to a random string (at least 32 bytes) in production!
JWT_SECRET=change-this-secret-to-a-long-random-string-at-least-32-bytes


# ═══════════════════════════════════════════════════════════════
# Image Storage Configuration - 图片存储配置
# ═══════════════════════════════════════════════════════════════
# true  = Supabase Storage (需要配置下面的 SUPABASE_* 参数)
# false = Local filesystem (存储在 backend/uploads/images/, 无需额外配置)
SUPABASE_STORAGE_ENABLED=false

# Supabase Storage (only required when SUPABASE_STORAGE_ENABLED=true)
# SUPABASE_URL=https://<your-project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
# SUPABASE_BUCKET_NAME=campaign-images


# ═══════════════════════════════════════════════════════════════
# Hyperledger Fabric Configuration 
# ═══════════════════════════════════════════════════════════════
FABRIC_VERSION=2.5.14
FABRIC_CA_VERSION=1.5.15
FABRIC_ENABLED=true
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=donation
FABRIC_MSP_ID=Org1MSP

FABRIC_PEER_ENDPOINT=peer0.org1.example.com:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_CERT_PATH=/fabric/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/signcerts/Admin@org1.example.com-cert.pem
FABRIC_KEY_PATH=/fabric/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/keystore
FABRIC_TLS_CERT_PATH=/fabric/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
