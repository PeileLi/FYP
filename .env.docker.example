# Docker Environment Configuration
# Copy this file to .env when running with docker-compose

# Database Configuration (Local PostgreSQL in Docker)
POSTGRES_DB=fyp_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/fyp_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT Secret
JWT_SECRET=change-this-secret-to-a-long-random-string-at-least-32-bytes

# Supabase Configuration (Optional - for file storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=campaign-images
SUPABASE_STORAGE_ENABLED=false

# Fabric Blockchain Configuration
# When running in Docker, use container names instead of localhost
FABRIC_ENABLED=true
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=donation
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=peer0.org1.example.com:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com

# Fabric Certificate Paths (mounted in Docker container)
# These paths are inside the container, not on the host
# IMPORTANT: Replace the keystore filename with the actual one from your setup
FABRIC_CERT_PATH=/fabric/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/signcerts/cert.pem
FABRIC_KEY_PATH=/fabric/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/keystore/priv_sk
FABRIC_TLS_CERT_PATH=/fabric/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
